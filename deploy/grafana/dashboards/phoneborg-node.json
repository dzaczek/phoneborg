   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(phoneborg_gateway_tokens_total{kind=\"prompt_cached\", node_id=\"$node\"}[5m])) / clamp_min(sum(rate(phoneborg_gateway_tokens_total{kind=\"prompt\", node_id=\"$node\"}[5m])), 1e-9)",
     "legendFormat": "cached",
     "datasource": {
      "type": "prometheus",
