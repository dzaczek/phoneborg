  {
   "type": "row",
   "title": "Tokens",
   "id": 11,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 5
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Input and output tokens per minute",
   "id": 12,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Prompt tokens the phone read and tokens it generated, per minute",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 6
   },
   "interval": "1m",
   "maxDataPoints": 1500,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "input",
     "expr": "sum(increase(phoneborg_gateway_tokens_total{kind=\"prompt\", node_id=\"$node\"}[1m]))"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "output",
     "expr": "sum(increase(phoneborg_gateway_tokens_total{kind=\"completion\", node_id=\"$node\"}[1m]))"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "custom": {
      "drawStyle": "bars",
      "barAlignment": 0,
      "lineWidth": 1,
      "fillOpacity": 80,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "input"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "output"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "sum",
      "max",
      "mean"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Output tokens per minute by model",
   "id": 13,
   "datasource": {
    "type": "prometheus",
