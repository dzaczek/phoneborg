     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "bargauge",
   "title": "Tokens by API key (time range)",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Who used this phone: input + output tokens per API key or principal",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (principal) (increase(phoneborg_gateway_tokens_total{kind=~\"prompt|completion\", node_id=\"$node\"}[$__range]))",
     "legendFormat": "{{principal}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Average tokens per request",
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Prompt and answer size of the requests this phone served (5-minute windows)",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 14
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(phoneborg_gateway_tokens_total{kind=\"prompt\", node_id=\"$node\"}[5m])) / clamp_min(sum(increase(phoneborg_gateway_requests_total{code=~\"2..\", node_id=\"$node\"}[5m])), 1)",
     "legendFormat": "input",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(increase(phoneborg_gateway_tokens_total{kind=\"completion\", node_id=\"$node\"}[5m])) / clamp_min(sum(increase(phoneborg_gateway_requests_total{code=~\"2..\", node_id=\"$node\"}[5m])), 1)",
     "legendFormat": "output",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "type": "timeseries",
