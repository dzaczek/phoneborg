{
 "uid": "phoneborg-node",
 "title": "PhoneBorg node",
 "tags": [
  "phoneborg"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "PhoneBorg on GitHub",
   "type": "link",
   "icon": "doc",
   "url": "https://github.com/dzaczek/phoneborg",
   "targetBlank": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "node",
    "label": "Node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(phoneborg_node_up, node_id)",
     "refId": "node"
    },
    "definition": "label_values(phoneborg_node_up, node_id)",
    "refresh": 2,
    "multi": false,
    "includeAll": false,
    "sort": 1
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Now",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "title": "Active",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "1 = ACTIVE",
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "phoneborg_node_up{node_id=\"$node\"}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
