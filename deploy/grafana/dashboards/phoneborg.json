    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(phoneborg_gateway_time_to_first_byte_seconds_bucket[2m])))",
     "legendFormat": "TTFB p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
