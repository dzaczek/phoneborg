FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY proto ./proto
COPY internal ./internal
COPY controller ./controller
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /controller ./controller/cmd/controller

FROM alpine:3.22
COPY --from=build /controller /usr/local/bin/controller
EXPOSE 18080
ENTRYPOINT ["controller"]
